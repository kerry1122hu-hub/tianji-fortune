RATE_LIMIT_WINDOW_MS=60000
REQUEST_TIMEOUT_MS=20000
UPSTREAM_RETRIES=3
UPSTREAM_RETRY_DELAY_MS=800
SIGNING_MAX_SKEW_MS=300000
LOG_DIR=./server/logs
