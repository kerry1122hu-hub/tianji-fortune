APP_ENV=production
PORT=8787
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5
ALLOW_ORIGIN=*
AI_PROXY_AUTH_TOKEN=
AI_PROXY_SIGNING_SECRET=
