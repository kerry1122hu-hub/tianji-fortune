{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mingme.app/schemas/chart-result.schema.json",
  "title": "ChartResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chart_id",
    "chart_hash",
    "chart_type",
    "generated_at",
    "engine_version",
    "versions",
    "subjects",
    "systems",
    "cross_system_links",
    "confidence",
    "warnings"
  ],
  "properties": {
    "chart_id": {
      "type": "string",
      "format": "uuid"
    },
    "chart_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "chart_type": {
      "type": "string",
      "enum": [
        "natal",
        "transit",
        "synastry",
        "composite",
        "solar_return",
        "lunar_return",
        "secondary_progression"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "versions": {
      "$ref": "#/$defs/VersionBundle"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/Subject"
      }
    },
    "subject_ref": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9_\\-]{1,64}$"
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/SystemResult"
      }
    },
    "cross_system_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CrossSystemLink"
      }
    },
    "confidence": {
      "$ref": "#/$defs/ConfidenceBundle"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Warning"
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "Subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "role", "birth_input"],
      "properties": {
        "subject_id": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "enum": ["native", "partner", "counterpart", "event", "transit_target"]
        },
        "birth_input": { "$ref": "#/$defs/BirthInput" }
      }
    },
    "BirthInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "birth_date",
        "birth_place_label_raw",
        "birth_place_label_normalized",
        "lat",
        "lng",
        "timezone",
        "dst_applied",
        "time_accuracy",
        "calendar"
      ],
      "properties": {
        "birth_date": { "type": "string", "format": "date" },
        "birth_time": {
          "type": ["string", "null"],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?$"
        },
        "birth_place_label_raw": { "type": "string", "minLength": 1 },
        "birth_place_label_normalized": { "type": "string", "minLength": 1 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "timezone": { "type": "string", "minLength": 1 },
        "dst_applied": { "type": "boolean" },
        "time_accuracy": {
          "type": "string",
          "enum": ["exact", "approximate", "noon", "unknown"]
        },
        "calendar": { "type": "string", "enum": ["gregorian"] }
      }
    },
    "SystemResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_code", "system_version", "facts", "confidence"],
      "properties": {
        "system_code": {
          "type": "string",
          "enum": ["western", "ziwei"]
        },
        "system_version": { "type": "string", "minLength": 1 },
        "config": { "$ref": "#/$defs/SystemConfig" },
        "facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/Fact" }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        },
        "confidence": { "$ref": "#/$defs/ConfidenceBundle" }
      }
    },
    "SystemConfig": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "zodiac": { "type": "string", "enum": ["tropical", "sidereal"] },
        "house_system": { "type": ["string", "null"] },
        "ayanamsa": { "type": ["string", "null"] },
        "ephemeris_source": { "type": ["string", "null"] }
      }
    },
    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "fact_code", "fact_type", "value"],
      "properties": {
        "fact_id": { "type": "string", "minLength": 1 },
        "fact_code": { "type": "string", "minLength": 1 },
        "fact_type": {
          "type": "string",
          "enum": [
            "point",
            "house",
            "aspect",
            "derived_metric",
            "palace",
            "star",
            "transformation",
            "auxiliary_star",
            "pattern",
            "cross_reference"
          ]
        },
        "subject_ref": { "type": ["string", "null"] },
        "source_path": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "value": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "array" },
            { "type": "object" },
            { "type": "null" }
          ]
        },
        "qualifiers": { "type": "object", "additionalProperties": true },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "CrossSystemLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link_id", "link_type", "fact_refs"],
      "properties": {
        "link_id": { "type": "string", "minLength": 1 },
        "link_type": {
          "type": "string",
          "enum": ["support", "contrast", "translation", "equivalence"]
        },
        "fact_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "ConfidenceBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall"],
      "properties": {
        "overall": { "type": "number", "minimum": 0, "maximum": 1 },
        "timing_sensitive_fields": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "system_specific": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "Warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "critical"]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "VersionBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_model", "engine", "schemas", "system_versions"],
      "properties": {
        "domain_model": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "timezone_db": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "schemas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chart_result"],
          "properties": {
            "chart_result": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "system_versions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "western": {
              "type": "string",
              "minLength": 1
            },
            "ziwei": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
