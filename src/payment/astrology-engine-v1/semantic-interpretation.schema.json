{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mingme.app/schemas/semantic-interpretation.schema.json",
  "title": "SemanticInterpretation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interpretation_id",
    "chart_id",
    "chart_type",
    "generated_at",
    "semantic_version",
    "ruleset_versions",
    "versions",
    "items",
    "aggregates",
    "guardrails",
    "confidence"
  ],
  "properties": {
    "interpretation_id": { "type": "string", "format": "uuid" },
    "chart_id": { "type": "string", "format": "uuid" },
    "chart_type": {
      "type": "string",
      "enum": [
        "natal",
        "transit",
        "synastry",
        "composite",
        "solar_return",
        "lunar_return",
        "secondary_progression"
      ]
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "semantic_version": { "type": "string", "minLength": 1 },
    "ruleset_versions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "versions": { "$ref": "#/$defs/VersionBundle" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/SemanticItem" }
    },
    "aggregates": { "$ref": "#/$defs/Aggregates" },
    "guardrails": {
      "type": "array",
      "items": { "$ref": "#/$defs/Guardrail" }
    },
    "confidence": { "$ref": "#/$defs/ConfidenceBundle" }
  },
  "$defs": {
    "SemanticItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "tag_code",
        "category",
        "strength",
        "polarity",
        "confidence",
        "themes",
        "provenance"
      ],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "tag_code": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
        },
        "category": {
          "type": "string",
          "enum": [
            "self",
            "career",
            "relationship",
            "wealth",
            "health",
            "timing",
            "purpose",
            "spirit"
          ]
        },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "polarity": {
          "type": "string",
          "enum": [
            "supportive",
            "challenging",
            "mixed",
            "neutral",
            "neutral_positive",
            "neutral_negative"
          ]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "themes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "qualifiers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cross_system_agreement": { "type": "boolean" },
        "cross_system_conflict": { "type": "boolean" },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Provenance" }
        },
        "render_hints": { "$ref": "#/$defs/RenderHints" }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "signal_code", "fact_refs"],
      "properties": {
        "system": {
          "type": "string",
          "enum": ["western", "ziwei"]
        },
        "signal_code": { "type": "string", "minLength": 1 },
        "fact_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rule_ref": { "type": ["string", "null"] },
        "contribution_weight": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "RenderHints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tone": {
          "type": "string",
          "enum": ["neutral", "warm", "clinical", "encouraging", "reflective"]
        },
        "claim_ceiling": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "suggested_sections": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "Aggregates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dominant_themes",
        "cross_system_agreements",
        "cross_system_conflicts"
      ],
      "properties": {
        "dominant_themes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "dominant_categories": {
          "deprecated": true,
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "dominant_domains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "cross_system_agreements": { "type": "integer", "minimum": 0 },
        "cross_system_conflicts": { "type": "integer", "minimum": 0 },
        "top_items": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "Guardrail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "critical"]
        },
        "message": { "type": "string", "minLength": 1 },
        "affected_scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "houses",
              "angles",
              "timing",
              "relationships",
              "career",
              "wealth",
              "health",
              "purpose",
              "spirit",
              "overall"
            ]
          }
        }
      }
    },
    "ConfidenceBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall"],
      "properties": {
        "overall": { "type": "number", "minimum": 0, "maximum": 1 },
        "item_average": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "agreement_bonus": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "VersionBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_model", "engine", "rulesets", "schemas"],
      "properties": {
        "domain_model": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "rulesets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "schemas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chart_result", "semantic_interpretation"],
          "properties": {
            "chart_result": {
              "type": "string",
              "minLength": 1
            },
            "semantic_interpretation": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
